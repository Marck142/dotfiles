# ГЛАВНЫЙ ВЫКЛЮЧАТЕЛЬ: False — никаких анимаций, слово появляется на месте.
ANIM_ENABLED = True

# Slide: слово приезжает сверху вниз к центру.
#   ANIM_SLIDE      — длительность в секундах (0.10 резко, 0.50 плавно).
#   ANIM_SLIDE_ROWS — на сколько строк выше центра слово стартует
#                     (2 едва заметно, 6 драматично).
ANIM_SLIDE = 0#.50
ANIM_SLIDE_ROWS = 9

# Fade: яркость от стартовой к полной.
#   ANIM_FADE       — длительность в секундах.
#   ANIM_FADE_FROM  — стартовая яркость (0.15 = почти чёрный, 0.6 = лёгкое
#                     затемнение). Конечная всегда 1.0.
ANIM_FADE = 0.50
ANIM_FADE_FROM = 0.15

# Pulse: дыхание яркости. ANIM_PULSE_AMP = 0 отключает пульс.
ANIM_PULSE_HZ = 0#4.0
ANIM_PULSE_AMP = 0.90

# Wave: горизонтальное покачивание строк. 0 = выключено.
ANIM_WAVE_AMP      = 1.5      # амплитуда в колонках (0.5 едва, 3 драматично)
ANIM_WAVE_HZ       = 0.5      # скорость бега фазы
ANIM_WAVE_K        = 1.1      # фазовый сдвиг между строками (радианы)

# Wave-Y: вертикальное покачивание всего блока. 0 = выключено.
ANIM_WAVE_Y_AMP    = 0#2.0      # амплитуда в строках (0.5, 1.0, 2.0)
ANIM_WAVE_Y_HZ     = 0.9

