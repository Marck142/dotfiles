#!/usr/bin/env python3
"""
glassy-lyrics — synced Spotify lyrics fullscreen, big-text mode.

All text is rendered through Pillow into a bitmap and converted to terminal
half-block characters — same style for ASCII, ß, Hangul, accents, emoji.
Lyric fetching runs in parallel background threads; first hit wins.

Sources (preferred order):
  0. Local override at ~/.config/glassy-lyrics/lrc/<Artist> - <Title>.lrc
     (use this when remote sources have incomplete LRCs; "/" → "_" in names).
  1. Spotify's own API — needs sp_dc cookie at ~/.config/glassy-lyrics/sp_dc.
     Some songs come back with LINE_AND_WORD_SYNCED → true word-level timing.
     (Currently blocked by Spotify's TOTP auth since 2025-10-18.)
  2. Better Lyrics API (lyrics-api.boidu.dev) — TTML with word/syllable timing,
     same data quality Spicy Lyrics (Spicetify) shows. Free for cached tracks.
  3. LRCLIB                                          — line-level only.
  4. python-syncedlyrics (Musixmatch / NetEase)      — line-level fallback.

Env vars:
  GLASSY_LYRICS_OFFSET     seconds added to playback position (positive = earlier).
  GLASSY_LYRICS_PLAYER     playerctl player name. Default "spotify".
  GLASSY_LYRICS_FALLBACK   1 (default) = also try syncedlyrics; 0 = skip.
  GLASSY_LYRICS_HEIGHT     big-text height in terminal rows. Default 8.
  GLASSY_LYRICS_DEBUG      1 = keep stderr visible (don't send to /dev/null).
  GLASSY_LYRICS_BOIDU_KEY  optional X-API-Key for Better Lyrics API (uncached
                           tracks / rate-limit bypass).
"""
import sys, os, time, signal, subprocess, json, shutil, threading, tempfile
import urllib.request, urllib.parse, re
import math

# --- custom palette / gradient layer -------------------------------------
# `palette.py` must sit next to this file. If it's missing, we fall back to
# a hardcoded gruvbox-ish palette so the script still runs.
try:
    from palette import load as load_palette, fg as palette_fg, accent_pair
    HAVE_PALETTE = True
except ImportError:
    HAVE_PALETTE = False

    _FALLBACK = {
        "background": (0x1a, 0x1a, 0x1a),
        "foreground": (0xe0, 0xe0, 0xe0),
        "color4": (0x45, 0x85, 0x88),
        "color5": (0xb1, 0x62, 0x86),
        "color8": (0x92, 0x83, 0x74),
    }

    def load_palette():
        return _FALLBACK

    def accent_pair():
        return _FALLBACK["color5"], _FALLBACK["color4"]

    def palette_fg(rgb):
        return f"\033[38;2;{rgb[0]};{rgb[1]};{rgb[2]}m"


def lerp_rgb(a, b, t):
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def gradient_lines(n, c_top, c_bot):
    """n цветов от c_top к c_bot (сверху вниз)."""
    if n <= 1:
        return [c_top]
    return [lerp_rgb(c_top, c_bot, i / (n - 1)) for i in range(n)]


def ease_out(t):
    return 1 - (1 - t) ** 3
